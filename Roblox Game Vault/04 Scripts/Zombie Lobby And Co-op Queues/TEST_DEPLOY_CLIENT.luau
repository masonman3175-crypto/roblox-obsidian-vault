local p=game.Players.LocalPlayer
assert(p:GetAttribute("QueuedMode")=="")
task.wait(.5);assert(p:GetAttribute("QueuedMode")=="")
p.Character:PivotTo(CFrame.new(1000,4,20));task.wait(.4)
p.Character:PivotTo(CFrame.new(979,4,-3));task.wait(.5)
assert(p:GetAttribute("QueuedMode")=="Duos")
p.Character:PivotTo(CFrame.new(937,4,-3));task.wait(.5)
assert(p:GetAttribute("QueuedMode")=="Solos")
task.wait(8.2)
assert(p:GetAttribute("LobbyPhase")=="Deployed")
local recorded=p:GetAttribute("LastDeploymentSpawn")
local c=require(game.ReplicatedStorage.LobbySystem.Config)
assert(recorded and (recorded-c.ArenaSpawn.Position).Magnitude<.01)
assert(p.Team.Name=="Survivors" and not p.Neutral)
assert(p:GetAttribute("CoopPartySize")==1 and p:GetAttribute("CoopPartyId")~="")
assert(p.Character:FindFirstChildOfClass("Tool")~=nil)
assert(p.CameraMode==Enum.CameraMode.LockFirstPerson)
return game.HttpService:JSONEncode({result="LIVE QUEUE PASS: actual Leave button; blocked rejoin; queue switching; Solo deploy; shared spawn; weapons restored",spawn=tostring(recorded),team=p.Team.Name,mode=p:GetAttribute("CoopMode")})
