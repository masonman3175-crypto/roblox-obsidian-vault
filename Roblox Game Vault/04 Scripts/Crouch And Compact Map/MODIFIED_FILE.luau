for _,p in boundary.ArchitecturalDetails:GetDescendants()do if p:IsA("BasePart")then
    local pos=p.Position;local size=p.Size
    if size.Z>size.X then
        pos=Vector3.new(pos.X+(pos.X<5 and 26 or -26),pos.Y,pos.Z*244/300)
        if size.Z>100 then size=Vector3.new(size.X,size.Y,p.Name=="WallCap" and 260 or size.Z*244/300)end
    else
        pos=Vector3.new(5+(pos.X-5)*482/534,pos.Y,pos.Z+(pos.Z<0 and 28 or -28))
        if size.X>100 then size=Vector3.new(p.Name=="WallCap" and 499 or size.X*498/550,size.Y,size.Z)end
    end
    p.CFrame=CFrame.new(pos)*p.CFrame.Rotation;p.Size=size
end end
boundary:SetAttribute("InnerMinX",xmin);boundary:SetAttribute("InnerMaxX",xmax)
boundary:SetAttribute("InnerMinZ",zmin);boundary:SetAttribute("InnerMaxZ",zmax)
-- Preserve visual/collision minimap alignment; apron proxies no longer exist.
for _,p in mini:GetChildren()do if p.Name:match("^Boundary_")then
    local name=p.Name:sub(10);local live=boundary:FindFirstChild(name)
    if live and live:IsA("BasePart")then p.CFrame=live.CFrame;p.Size=live.Size else p:Destroy()end
end end
-- Clip sidewalk tiles around curbs and soil instead of layering near-coincident surfaces.
local cutters={}
local function rect(p)
    local x=p.Size.X*math.abs(p.CFrame.RightVector.X)+p.Size.Z*math.abs(p.CFrame.LookVector.X)
    local z=p.Size.X*math.abs(p.CFrame.RightVector.Z)+p.Size.Z*math.abs(p.CFrame.LookVector.Z)
    return {p.Position.X-x/2-.025,p.Position.X+x/2+.025,p.Position.Z-z/2-.025,p.Position.Z+z/2+.025}
end
for _,p in map.Ground.Sidewalks:GetChildren()do
    if p:IsA("BasePart") and p.Name=="Curb"then table.insert(cutters,rect(p))end
    if p:IsA("BasePart") and p.Name=="Sidewalk"then
        local bottom=p.Position.Y-p.Size.Y/2
        p.Size=Vector3.new(p.Size.X,.5-bottom,p.Size.Z)
        p.Position=Vector3.new(p.Position.X,(.5+bottom)/2,p.Position.Z)
    end
end
for _,p in map.Props.StreetTrees:GetDescendants()do if p:IsA("BasePart") and p.Name=="Soil"then table.insert(cutters,rect(p))end end
local function subtract(r,c,out)
    local a,b=math.max(r[1],c[1]),math.min(r[2],c[2])
    local d,e=math.max(r[3],c[3]),math.min(r[4],c[4])
    if b<=a or e<=d then table.insert(out,r);return end
    for _,n in {{r[1],a,r[3],r[4]},{b,r[2],r[3],r[4]},{a,b,r[3],d},{a,b,e,r[4]}}do
        if n[2]-n[1]>.08 and n[4]-n[3]>.08 then table.insert(out,n)end
