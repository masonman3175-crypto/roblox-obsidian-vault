local replacement=Instance.new("Folder");replacement.Name="SidewalkSlabs"
local tileCount=0
for index,p in old:GetChildren()do if p:IsA("BasePart")then
    local list={{p.Position.X-p.Size.X/2,p.Position.X+p.Size.X/2,p.Position.Z-p.Size.Z/2,p.Position.Z+p.Size.Z/2}}
    for _,cut in cutters do local nextList={};for _,r in list do subtract(r,cut,nextList)end;list=nextList end
    for _,r in list do
        local n=p:Clone();n.Size=Vector3.new(r[2]-r[1],.16,r[4]-r[3]);n.CFrame=CFrame.new((r[1]+r[2])/2,.72,(r[3]+r[4])/2)
        n.Parent=replacement;tileCount+=1
    end
end
if index%100==0 then task.wait()end end
assert(tileCount<1000,"Split tile insertion into chunks")
old:Destroy();replacement.Parent=map.Ground
-- A redundant patch overlap has no unique collision; hide only the duplicate overlay.
local accepted={};local hidden=0
for _,p in map.Ground.RoadDetail:GetChildren()do if p:IsA("BasePart")and p.Name=="Patch"then
    local r=rect(p);local overlap=false
    for _,q in accepted do if math.min(r[2],q[2])-math.max(r[1],q[1])>.1 and math.min(r[4],q[4])-math.max(r[3],q[3])>.1 then overlap=true;break end end
    if overlap then p.Transparency=1;p.CanCollide=false;p.CanQuery=false;hidden+=1 else table.insert(accepted,r)end
end end
-- Both old corner pads would be outside the new flush building footprint.
local blue=map.Spawns.Spawn_West;local red=map.Spawns.Spawn_East
blue.CFrame=CFrame.lookAt(Vector3.new(-186,.9,-115),Vector3.new(5,.9,0))
red.CFrame=CFrame.lookAt(Vector3.new(182,.7,108),Vector3.new(5,.7,0))
game.SoundService.BackgroundMusic.Volume=.05
game:GetService("ChangeHistoryService"):SetWaypoint("Quieter music crouch compact walls and floor repair")
return game.HttpService:JSONEncode({result="INSTALL PASS",music=.05,bounds={xmin,xmax,zmin,zmax},oldArea=534*300,newArea=482*244,tiles=tileCount,hiddenPatches=hidden})

